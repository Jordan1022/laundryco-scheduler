{
  "name": "laundryco-scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/run-with-system-node.cjs ./node_modules/next/dist/bin/next dev",
    "build": "node ./scripts/run-with-system-node.cjs ./node_modules/next/dist/bin/next build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then drizzle-kit migrate; fi && npm run build",
    "start": "node ./scripts/run-with-system-node.cjs ./node_modules/next/dist/bin/next start",
    "test": "node --require ./tests/rollup-wasm-shim.cjs ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --require ./tests/rollup-wasm-shim.cjs ./node_modules/vitest/vitest.mjs",
    "lint": "node ./scripts/run-with-system-node.cjs ./node_modules/next/dist/bin/next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "create-user": "tsx scripts/create-user.ts",
    "generate:vapid": "node scripts/generate-vapid-keys.mjs",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.2",
    "@sentry/nextjs": "^10.53.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.379.0",
    "next": "15.5.28",
    "next-auth": "^4.24.7",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.60.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.19.32",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "15.5.28",
    "jsdom": "^24.1.3",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
